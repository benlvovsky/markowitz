{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // "node" is here because two files in `include` genuinely run in node rather than the
    // browser: vite.config.ts, and portfolio.test.ts, which reads public/data/*.json off disk
    // so that it tests the committed artifacts instead of a fixture that can drift from them.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
